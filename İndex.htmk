<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#8B6B4A" />
<title>İç Mimari AI</title>
<link rel="manifest" href="manifest.json" />
<link rel="icon" href="icons/icon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="icons/icon-192.png" />
<link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="topbar">
    <h1>İç Mimari AI</h1>
    <p class="subtitle">Odanı fotoğrafla, tarzını seç, AI yeniden tasarlasın.</p>
  </header>

  <main>
    <section class="card">
      <h2>1. Oda Fotoğrafı</h2>
      <label for="fileInput" class="upload-box" id="uploadBox">
        <span id="uploadHint">Dokun ve fotoğraf seç</span>
        <img id="preview" alt="önizleme" hidden />
      </label>
      <input id="fileInput" type="file" accept="image/*" capture="environment" hidden />
    </section>

    <section class="card">
      <h2>2. Tarz Seç</h2>
      <div id="styleGrid" class="style-grid"></div>
    </section>

    <section class="card">
      <h2>3. Ölçüler (opsiyonel)</h2>
      <div class="measure-grid">
        <label>En (m)<input id="mWidth" type="number" step="0.1" min="1" placeholder="4.0"></label>
        <label>Boy (m)<input id="mLength" type="number" step="0.1" min="1" placeholder="5.0"></label>
        <label>Yükseklik (m)<input id="mHeight" type="number" step="0.1" min="2" placeholder="2.7"></label>
      </div>
      <p class="hint">Şimdilik sadece kaydediliyor; sonraki sürümde prompt'a eklenecek.</p>
    </section>

    <section class="card">
      <button id="generateBtn" class="primary">Tasarla</button>
      <button id="apiKeyBtn" class="ghost">Replicate API anahtarını ayarla</button>
    </section>

    <section id="resultSection" class="card" hidden>
      <h2 id="resultTitle">Sonuç</h2>
      <div id="loader" class="loader" hidden></div>
      <p id="errorText" class="error" hidden></p>
      <img id="resultImage" alt="AI sonucu" hidden />
      <a id="downloadLink" class="ghost" download="tasarim.jpg" hidden>İndir</a>
    </section>
  </main>

  <dialog id="apiDialog">
    <form method="dialog">
      <h3>Replicate API Anahtarı</h3>
      <p class="hint">replicate.com/account/api-tokens adresinden alabilirsin.</p>
      <input id="apiInput" type="text" placeholder="r8_..." autocomplete="off" />
      <menu>
        <button value="cancel" class="ghost">İptal</button>
        <button value="save" class="primary" id="apiSaveBtn">Kaydet</button>
      </menu>
    </form>
  </dialog>

  <script src="styles-catalog.js"></script>
  <script src="replicate.js"></script>
  <script src="app.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('service-worker.js');
    }
  </script>
</body>
</html>
